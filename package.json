{
  "name": "python-learner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "predev": "npm run copy-pyodide",
    "prebuild": "npm run copy-pyodide",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate-content": "node scripts/validate-content.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test visual --update-snapshots"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14",
    "pyodide": "^314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
